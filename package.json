{
  "name": "transwave-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "npm run build:packages && concurrently --kill-others-on-fail --names api,web --prefix-colors magenta,blue \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm run dev -w @transwave/web",
    "dev:api": "npm run start:dev -w @transwave/api",
    "build:packages": "npm run build -w @transwave/contracts && npm run build -w @transwave/database",
    "build": "npm run build:packages && npm run build -w @transwave/api && npm run build -w @transwave/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:security": "node scripts/security-local.mjs",
    "test:vendor-cost": "node scripts/vendor-cost-local.mjs",
    "test:smoke": "npm run db:reset && node scripts/smoke-local.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/database/src/database.types.ts"
  },
  "devDependencies": {
    "concurrently": "10.0.5",
    "supabase": "2.117.0",
    "typescript": "6.0.3"
  },
  "packageManager": "npm@11.6.2"
}
