{
  "name": "@transwave/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "node --import tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test:unit": "node --import tsx --test src/**/*.spec.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-fastify": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@fastify/static": "10.1.2",
    "@supabase/supabase-js": "2.116.0",
    "@transwave/contracts": "0.1.0",
    "@transwave/database": "0.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@types/node": "24.3.0",
    "eslint": "9.35.0",
    "eslint-config-prettier": "10.1.8",
    "source-map-support": "0.5.21",
    "ts-node": "10.9.2",
    "tsx": "4.20.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
